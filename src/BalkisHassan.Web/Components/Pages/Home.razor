@page "/"
@inject ApplicationDbContext Db
<SeoHead Title="بلقيس حميد حسن — شاعرة وكاتبة عراقية" Description="قصائد وكتب ومقالات ومحطات من سيرة الشاعرة والكاتبة العراقية بلقيس حميد حسن." CanonicalPath="/" />
@if (Loaded)
{
<section class="hero"><div class="hero-copy"><span class="eyebrow">شعر · أدب · ذاكرة</span><h1>بلقيس<br /><em>حميد حسن</em></h1><p>مساحة تجمع القصائد والكتب والمقالات ومحطات السيرة الأدبية.</p>
    @if (Latest.Count > 0) { <a class="text-link" href="#latest-publications">اقرأ أحدث النصوص <span>←</span></a> }
</div><div class="hero-visual">@if (PortraitPath is not null) { <img src="@PortraitPath" alt="بلقيس حميد حسن" width="138" height="166" fetchpriority="high" /> } else if (Hero?.MainImage is not null) { <img src="@Hero.MainImage" alt="بلقيس حميد حسن" width="138" height="166" fetchpriority="high" /> } else { <div class="hero-monogram" aria-hidden="true">ب</div> }<span class="vertical-note">بغداد · العالم · القصيدة</span></div></section>
@if (Biography is not null) {
<section class="section biography-section"><div class="shell biography-grid">
    @if (PortraitPath is not null) { <figure class="biography-portrait"><img src="@PortraitPath" alt="صورة الشاعرة بلقيس حميد حسن" width="138" height="166" loading="lazy" /></figure> }
    <div class="biography-copy"><span class="eyebrow">محطات من السيرة الذاتية</span><h2>من هي بلقيس حميد حسن؟</h2><p class="biography-lead">شاعرة وكاتبة عراقية من مدينة سوق الشيوخ في محافظة الناصرية، نشأت في عائلة شعرية وبدأت كتابة الشعر منذ صغرها.</p><p>تنقلت حياتها بين العراق ولبنان وسوريا ثم هولندا، وارتبط شعرها وكتابتها بالدفاع عن الإنسان وحقوق المرأة والحرية. يضم أرشيفها دواوين شعرية وروايات ومئات المقالات، إلى جانب حضورها في أمسيات ومهرجانات عربية وأوروبية.</p><a class="text-link" href="/content/@Biography.Slug">اقرأ السيرة كاملة <span>←</span></a></div>
</div></section> }
@if (Featured.Count > 0) { <section class="section shell"><header class="section-heading"><span>مختارات</span><h2>نصوص مميزة</h2></header><div class="featured-grid">@foreach (var item in Featured.Take(4)) { <ContentCard Item="item" /> }</div></section> }
<section id="latest-publications" class="section latest-section"><div class="shell"><header class="section-heading light"><span>من الأرشيف والجديد</span><h2>آخر المنشورات</h2></header><div class="latest-list">@foreach (var item in Latest) { <ContentRow Item="item" /> }</div></div></section>
<section class="section shell"><header class="section-heading"><span>استكشف</span><h2>أبواب الموقع</h2></header><div class="category-cloud">@foreach (var category in Categories) { <a href="@CategoryUrl(category)"><span>@category.Name</span><small>@category.Description</small></a> }</div></section>
}
@code {
    private bool Loaded;
    private List<ContentItem> Featured = [];
    private List<ContentItem> Latest = [];
    private List<Category> Categories = [];
    private ContentItem? Hero;
    private ContentItem? Biography;
    private string? PortraitPath;

    protected override async Task OnInitializedAsync()
    {
        var now = DateTimeOffset.UtcNow;
        var query = Db.ContentItems.AsNoTracking().Include(x => x.Category)
            .Where(x => x.IsPublished && (x.PublishedAt == null || x.PublishedAt <= now) && x.Category.IsVisible);
        Latest = await query.OrderByDescending(x => x.PublishedAt.HasValue).ThenByDescending(x => x.PublishedAt).ThenByDescending(x => x.Id).Take(12).ToListAsync();
        Featured = await query.Where(x => x.Featured).OrderByDescending(x => x.PublishedAt.HasValue).ThenByDescending(x => x.PublishedAt).Take(6).ToListAsync();
        Categories = await Db.Categories.AsNoTracking().Where(x => x.IsVisible).OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();
        Hero = Featured.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.MainImage)) ?? Latest.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.MainImage)) ?? Latest.FirstOrDefault();
        Biography = await Db.ContentItems.AsNoTracking().SingleOrDefaultAsync(x => x.LegacyJoomlaId == 6 && x.IsPublished);
        PortraitPath = await Db.MediaItems.AsNoTracking().Where(x => x.LegacyPath != null && x.LegacyPath.ToLower() == "images/stories/balkis.jpg").Select(x => x.Path).FirstOrDefaultAsync();
        Loaded = true;
    }

    private static string CategoryUrl(Category category) => category.LegacyJoomlaId == 6 ? "/content/أعمال-الشاعرة" : $"/category/{category.Slug}";
}
