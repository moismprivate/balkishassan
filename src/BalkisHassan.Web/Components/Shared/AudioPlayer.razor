@if (!string.IsNullOrWhiteSpace(Item.AudioPath))
{
<section class="audio-player" data-audio-player>
    <audio class="audio-element" preload="metadata"><source src="@Item.AudioPath" type="audio/mpeg" />متصفحك لا يدعم تشغيل الصوت.</audio>
    <div class="audio-player-main"><button class="audio-toggle" type="button" aria-label="تشغيل الصوت"><span class="audio-toggle-icon" aria-hidden="true">▶</span><span class="audio-toggle-label">تشغيل الصوت</span></button><div class="audio-meta"><strong>استمع بصوت الشاعرة</strong><span dir="ltr"><b data-audio-current>0:00</b> / <b data-audio-duration>--:--</b></span></div></div>
    <input class="audio-progress" data-audio-progress type="range" min="0" max="1000" value="0" aria-label="موضع التسجيل" />
    <div class="audio-player-links"><a href="@Item.AudioPath" download>تنزيل ملف MP3</a><a href="@Item.AudioPath" target="_blank" rel="noopener">فتح الصوت مباشرة</a></div>
    <p class="audio-message" data-audio-message hidden>تعذّر التشغيل في هذا المتصفح. يمكنك تنزيل الملف أو فتحه مباشرة.</p>
</section>
}
@code { [Parameter, EditorRequired] public ContentItem Item { get; set; } = null!; }
