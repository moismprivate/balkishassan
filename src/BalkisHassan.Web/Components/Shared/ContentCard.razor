@{ var hasImage = !string.IsNullOrWhiteSpace(Item.MainImage); var youtubeId = YouTubeEmbed.FindVideoId(Item.Content); }
<article class="content-card @(hasImage ? "with-image" : "without-image")">
@if (hasImage) { <a class="card-image" href="/content/@Item.Slug"><img src="@Item.MainImage" alt="@Item.Title" width="640" height="420" loading="lazy" /></a> }
<div class="card-copy"><small>@Item.Category.Name</small><h3><a href="/content/@Item.Slug">@Item.Title</a></h3>@if (youtubeId is not null) { <a class="card-video-link" href="/content/@Item.Slug"><span aria-hidden="true">▶</span><strong>مشاهدة الفيديو</strong></a> } else if (!string.IsNullOrWhiteSpace(Item.Summary)) { <p>@((MarkupString)Item.Summary)</p> }<time datetime="@Item.PublishedAt?.ToString("O")">@Item.PublishedAt?.ToString("d MMMM yyyy")</time>@if (!string.IsNullOrWhiteSpace(Item.AudioPath)) { <AudioPlayer Item="Item" /> }</div>
</article>
@code { [Parameter, EditorRequired] public ContentItem Item { get; set; } = null!; }
