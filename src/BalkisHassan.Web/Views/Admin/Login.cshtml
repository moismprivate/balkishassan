@model BalkisHassan.Web.Models.LoginViewModel
@{ ViewData["Title"] = "تسجيل الدخول"; }
<section class="login-panel"><span class="brand-mark">ب</span><h1>تسجيل الدخول</h1><p>إدارة محتويات موقع بلقيس حميد حسن</p><form method="post"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" /><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Email">البريد الإلكتروني</label><input asp-for="Email" dir="ltr" autocomplete="username" /><span asp-validation-for="Email"></span><label asp-for="Password">كلمة المرور</label><input asp-for="Password" dir="ltr" autocomplete="current-password" /><span asp-validation-for="Password"></span><label class="check"><input asp-for="RememberMe" /> تذكرني</label><button class="primary-button" type="submit">دخول</button></form></section>
