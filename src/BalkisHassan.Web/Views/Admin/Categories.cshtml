@model IReadOnlyList<BalkisHassan.Domain.Category>
@{ ViewData["Title"] = "التصنيفات"; }
<header class="admin-heading"><div><span>تنظيم المحتوى</span><h1>التصنيفات</h1><p>رتبي أبواب الموقع وأسماءها.</p></div></header>
<section class="form-card new-category"><h2>إضافة تصنيف</h2><form method="post" action="/admin/category/save"><input type="hidden" name="id" value="0" /><div><label>الاسم<input name="name" required /></label><label>الرابط المختصر<input name="slug" dir="ltr" /></label><label>الترتيب<input name="sortOrder" type="number" value="0" /></label><label class="check"><input name="isVisible" type="checkbox" value="true" checked /> ظاهر</label><button class="primary-button">إضافة</button></div></form></section>
<div class="category-admin-list">@foreach (var category in Model) { <form method="post" action="/admin/category/save" class="form-card"><input type="hidden" name="id" value="@category.Id" /><div class="category-form-row"><label>الاسم<input name="name" value="@category.Name" required /></label><label>الرابط<input name="slug" value="@category.Slug" dir="ltr" /></label><label>الترتيب<input name="sortOrder" value="@category.SortOrder" type="number" /></label><label class="check"><input name="isVisible" type="checkbox" value="true" checked="@category.IsVisible" /> ظاهر</label></div><label>الوصف<textarea name="description" rows="2">@category.Description</textarea></label><button class="secondary-button">حفظ التعديلات</button></form> }</div>
