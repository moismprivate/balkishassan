@model BalkisHassan.Web.Models.AdminMediaViewModel
@{ ViewData["Title"] = "الوسائط"; }
<header class="admin-heading"><div><span>الصور والملفات</span><h1>الوسائط</h1><p>الأنواع المسموحة: JPG، PNG، WEBP، GIF، MP3، OGG، WAV، PDF. الحد الأقصى 25 ميغابايت.</p></div></header>
<section class="upload-panel"><form method="post" enctype="multipart/form-data"><div><label for="file">اختيار الملف</label><input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,audio/mpeg,audio/ogg,audio/wav,application/pdf" required /></div><div><label for="altText">النص البديل للصورة</label><input id="altText" name="altText" /></div><button class="primary-button">رفع الملف</button></form>@if (Model.Error is not null) { <p class="validation">@Model.Error</p> }</section>
<div class="media-grid">@foreach (var item in Model.Items) { <article>@if (item.MimeType.StartsWith("image/")) { <img src="@item.Path" alt="@item.AltText" loading="lazy" /> } else if (item.MimeType.StartsWith("audio/")) { <div class="file-icon">♫</div> } else { <div class="file-icon">PDF</div> }<div><strong>@item.OriginalFileName</strong><input value="@item.Path" readonly dir="ltr" aria-label="مسار الملف" /><small>@Math.Ceiling(item.Size / 1024d) KB</small></div></article> }</div>
