@model BalkisHassan.Web.Models.ContentEditViewModel
@using BalkisHassan.Domain
@{ var isNew = Model.Id == 0; ViewData["Title"] = isNew ? "محتوى جديد" : "تعديل المحتوى"; var media = ViewBag.Media as IReadOnlyList<MediaItem> ?? []; }
<header class="admin-heading"><div><span>@(isNew ? "إضافة" : "تحرير")</span><h1>@(isNew ? "محتوى جديد" : Model.Title)</h1></div><a class="secondary-button" href="/admin/contents">عودة إلى القائمة</a></header>
<form class="content-form" method="post" action="@(isNew ? "/admin/content/new" : $"/admin/content/{Model.Id}")"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="form-layout"><div class="form-main"><label asp-for="Title">العنوان</label><input asp-for="Title" class="title-input" /><span asp-validation-for="Title"></span>
<label asp-for="Summary">المقدمة القصيرة</label><textarea asp-for="Summary" rows="3"></textarea>
<label>النص</label><div class="editor-toolbar" role="toolbar" aria-label="تنسيق النص"><button type="button" data-command="bold"><b>عريض</b></button><button type="button" data-command="italic"><i>مائل</i></button><button type="button" data-command="formatBlock" data-value="p">فقرة</button><button type="button" data-command="formatBlock" data-value="h2">عنوان</button><button type="button" data-command="insertUnorderedList">قائمة</button><button type="button" data-command="createLink">رابط</button></div><textarea asp-for="Content" class="editor-source"></textarea><div class="rich-editor" contenteditable="true" data-source="Content" dir="rtl">@Html.Raw(Model.Content)</div><span asp-validation-for="Content"></span>
<details class="advanced-fields"><summary>الرابط المختصر والملفات</summary><label asp-for="Slug">الرابط المختصر</label><input asp-for="Slug" dir="ltr" /><label asp-for="MainImage">الصورة الرئيسية</label><input asp-for="MainImage" list="image-list" dir="ltr" /><datalist id="image-list">@foreach (var item in media.Where(x => x.MimeType.StartsWith("image/"))) { <option value="@item.Path">@item.OriginalFileName</option> }</datalist><label asp-for="AudioPath">التسجيل الصوتي</label><input asp-for="AudioPath" list="audio-list" dir="ltr" /><datalist id="audio-list">@foreach (var item in media.Where(x => x.MimeType.StartsWith("audio/"))) { <option value="@item.Path">@item.OriginalFileName</option> }</datalist><label asp-for="DocumentPath">ملف الكتاب أو الوثيقة</label><input asp-for="DocumentPath" list="document-list" dir="ltr" /><datalist id="document-list">@foreach (var item in media.Where(x => x.MimeType == "application/pdf")) { <option value="@item.Path">@item.OriginalFileName</option> }</datalist></details></div>
<aside class="form-side"><div class="form-card"><h2>النشر</h2><label asp-for="CategoryId">التصنيف</label><select asp-for="CategoryId" asp-items="ViewBag.Categories"><option value="">اختاري تصنيفاً</option></select><span asp-validation-for="CategoryId"></span><label asp-for="Type">النوع</label><select asp-for="Type"><option value="Article">مقال</option><option value="Poem">قصيدة</option><option value="Book">كتاب</option><option value="Interview">لقاء</option><option value="Biography">محطة</option><option value="AudioPoem">قصيدة صوتية</option></select><label asp-for="PublishedAt">تاريخ النشر</label><input asp-for="PublishedAt" type="datetime-local" /><label class="check"><input asp-for="IsPublished" /> منشور</label><label class="check"><input asp-for="Featured" /> مميز في الرئيسية</label><label asp-for="SortOrder">ترتيب يدوي</label><input asp-for="SortOrder" type="number" /><button class="primary-button" type="submit">حفظ المحتوى</button></div></aside></div></form>
