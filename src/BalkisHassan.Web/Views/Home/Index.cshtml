@model BalkisHassan.Web.Models.HomeViewModel
@{ ViewData["Title"] = "بلقيس حميد حسن — شاعرة وكاتبة عراقية"; ViewData["Description"] = "قصائد وكتب ومقالات ومحطات من سيرة الشاعرة والكاتبة العراقية بلقيس حميد حسن."; }
<section class="hero"><div class="hero-copy"><span class="eyebrow">شعر · أدب · ذاكرة</span><h1>بلقيس<br /><em>حميد حسن</em></h1><p>مساحة تجمع القصائد والكتب والمقالات ومحطات السيرة الأدبية.</p>
    @if (Model.Hero is not null) { <a class="text-link" href="/content/@Model.Hero.Slug">اقرأ أحدث النصوص <span>←</span></a> }
</div><div class="hero-visual">@if (Model.PortraitPath is not null) { <img src="@Model.PortraitPath" alt="بلقيس حميد حسن" width="760" height="900" fetchpriority="high" /> } else if (Model.Hero?.MainImage is not null) { <img src="@Model.Hero.MainImage" alt="بلقيس حميد حسن" width="760" height="900" fetchpriority="high" /> } else { <div class="hero-monogram" aria-hidden="true">ب</div> }<span class="vertical-note">بغداد · العالم · القصيدة</span></div></section>
@if (Model.Featured.Count > 0) { <section class="section shell"><header class="section-heading"><span>مختارات</span><h2>نصوص مميزة</h2></header><div class="featured-grid">@foreach (var item in Model.Featured.Take(4)) { <partial name="_ContentCard" model="item" /> }</div></section> }
<section class="section latest-section"><div class="shell"><header class="section-heading light"><span>من الأرشيف والجديد</span><h2>آخر المنشورات</h2></header><div class="latest-list">@foreach (var item in Model.Latest) { <partial name="_ContentRow" model="item" /> }</div></div></section>
<section class="section shell"><header class="section-heading"><span>استكشف</span><h2>أبواب الموقع</h2></header><div class="category-cloud">@foreach (var category in Model.Categories) { <a href="/category/@category.Slug"><span>@category.Name</span><small>@category.Description</small></a> }</div></section>
