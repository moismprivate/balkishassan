<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@ViewData["Title"] — إدارة الموقع</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600&family=Noto+Naskh+Arabic:wght@400;600;700&display=swap" rel="stylesheet" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body class="admin-body"><header class="admin-topbar"><a href="/admin" class="admin-brand"><span>ب</span> إدارة موقع بلقيس</a>@if (User.Identity?.IsAuthenticated == true) { <nav><a href="/" target="_blank">عرض الموقع ↗</a><form method="post" action="/admin/logout">@Html.AntiForgeryToken()<button>تسجيل الخروج</button></form></nav> }</header>
<div class="admin-shell @(User.Identity?.IsAuthenticated == true ? "" : "unauthenticated")">@if (User.Identity?.IsAuthenticated == true) { <aside class="admin-sidebar"><a href="/admin">لوحة التحكم</a><a href="/admin/content/new">مقال جديد</a><a href="/admin/content/new?type=Poem">قصيدة جديدة</a><a href="/admin/contents">المحتويات</a><a href="/admin/categories">التصنيفات</a><a href="/admin/media">الوسائط</a></aside> }<main class="admin-main">@if (TempData["Message"] is string message) { <div class="flash">@message</div> }@RenderBody()</main></div>
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", false)</body></html>
