<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "بلقيس حميد حسن")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "الموقع الرسمي للشاعرة والكاتبة العراقية بلقيس حميد حسن")" />
    <link rel="canonical" href="@(ViewData["Canonical"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "بلقيس حميد حسن")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "شعر وكتب ومقالات بلقيس حميد حسن")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@(ViewData["Canonical"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    @if (ViewData["Image"] is string image) { var ogImage = image.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? image : $"{Context.Request.Scheme}://{Context.Request.Host}{image}"; <meta property="og:image" content="@ogImage" /> }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">انتقل إلى المحتوى</a>
    <header class="site-header"><div class="header-inner">
        <a class="brand" href="/" aria-label="الصفحة الرئيسية"><span class="brand-mark">ب</span><span><strong>بلقيس حميد حسن</strong><small>شاعرة وكاتبة عراقية</small></span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu"><span></span><span></span><span></span><b>القائمة</b></button>
        <nav id="main-menu" class="main-nav" aria-label="التنقل الرئيسي">
            <a href="/">الرئيسية</a><a href="/category/قصائد">قصائد</a><a href="/category/كتب-بلقيس">كتب بلقيس</a>
            <a href="/category/من-مقالات-الشاعرة">مقالات</a><a href="/category/محطات">محطات</a><a href="/category/كتب-عن-الشاعرة">كتب عن الشاعرة</a><a href="/category/لقاءات-مع-الشاعرة">لقاءات</a>
            <a href="/category/قصائد-بصوت-الشاعرة">بصوت الشاعرة</a><a href="/links">مواقع</a><a href="/contact">البريد الإلكتروني</a>
        </nav>
        <form class="header-search" action="/search" method="get" role="search"><label class="sr-only" for="q">بحث</label><input id="q" name="q" type="search" placeholder="ابحث في الموقع" /><button type="submit" aria-label="بحث">⌕</button></form>
    </div></header>
    <main id="main">@RenderBody()</main>
    <footer class="site-footer"><div class="footer-inner"><div><strong>بلقيس حميد حسن</strong><p>مساحة للشعر والكتابة والذاكرة.</p></div><nav aria-label="روابط التذييل"><a href="/">الرئيسية</a><a href="/links">مواقع</a><a href="/contact">اتصل بنا</a></nav><p class="copyright">© @DateTime.Now.Year جميع الحقوق محفوظة</p></div></footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
