@model BalkisHassan.Domain.ContentItem
@using BalkisHassan.Web.Utilities
@{ var isBiography = Model.LegacyJoomlaId == 6; var displayTitle = isBiography ? "السيرة الذاتية" : Model.Title; var sectionTitle = isBiography ? "محطات من السيرة الذاتية" : Model.Category.Name; ViewData["Title"] = $"{displayTitle} — بلقيس حميد حسن"; ViewData["Description"] = Model.Summary; ViewData["Image"] = Model.MainImage; var youtubeId = YouTubeEmbed.FindVideoId(Model.Content); var articleContent = youtubeId is null ? Model.Content : YouTubeEmbed.RemoveVideoLinks(Model.Content); if (isBiography) { var biographyText = articleContent.IndexOf("ولدت بلقيس", StringComparison.Ordinal); var biographyParagraph = biographyText < 0 ? -1 : articleContent.LastIndexOf("<p", biographyText, StringComparison.OrdinalIgnoreCase); if (biographyParagraph >= 0) articleContent = articleContent[biographyParagraph..]; } var showSummary = !isBiography && !string.IsNullOrWhiteSpace(Model.Summary) && YouTubeEmbed.FindVideoId(Model.Summary) is null; }
<article class="article-page @(Model.Type is BalkisHassan.Domain.ContentType.Poem or BalkisHassan.Domain.ContentType.AudioPoem ? "poem-page" : "")"><header class="article-header shell"><nav class="breadcrumbs"><a href="/">الرئيسية</a><span>/</span>@if (Model.Category.IsVisible) { <a href="/category/@Model.Category.Slug">@Model.Category.Name</a> } else { <span>@sectionTitle</span> }</nav><small>@sectionTitle</small><h1>@displayTitle</h1>@if (showSummary) { <p class="lead">@Html.Raw(Model.Summary)</p> }<time datetime="@Model.PublishedAt?.ToString("O")">@Model.PublishedAt?.ToString("d MMMM yyyy")</time></header>
@if (!string.IsNullOrWhiteSpace(Model.MainImage)) { <figure class="article-image shell"><img src="@Model.MainImage" alt="@Model.Title" width="1200" height="720" /></figure> }
<div class="article-body shell">@Html.Raw(articleContent) @if (youtubeId is not null) { <div class="video-heading"><span aria-hidden="true">▶</span><strong>مشاهدة الفيديو</strong></div><div class="video-embed"><iframe src="https://www.youtube-nocookie.com/embed/@youtubeId" title="@displayTitle" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div> } @if (!string.IsNullOrWhiteSpace(Model.AudioPath)) { <partial name="_AudioPlayer" model="Model" /> } @if (!string.IsNullOrWhiteSpace(Model.DocumentPath)) { <a class="download-link" href="@Model.DocumentPath" download>تنزيل الكتاب أو الوثيقة</a> }</div></article>
