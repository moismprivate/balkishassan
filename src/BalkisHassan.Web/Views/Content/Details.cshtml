@model BalkisHassan.Domain.ContentItem
@{ ViewData["Title"] = $"{Model.Title} — بلقيس حميد حسن"; ViewData["Description"] = Model.Summary; ViewData["Image"] = Model.MainImage; }
<article class="article-page @(Model.Type is BalkisHassan.Domain.ContentType.Poem or BalkisHassan.Domain.ContentType.AudioPoem ? "poem-page" : "")"><header class="article-header shell"><nav class="breadcrumbs"><a href="/">الرئيسية</a><span>/</span><a href="/category/@Model.Category.Slug">@Model.Category.Name</a></nav><small>@Model.Category.Name</small><h1>@Model.Title</h1>@if (!string.IsNullOrWhiteSpace(Model.Summary)) { <p class="lead">@Html.Raw(Model.Summary)</p> }<time datetime="@Model.PublishedAt?.ToString("O")">@Model.PublishedAt?.ToString("d MMMM yyyy")</time></header>
@if (!string.IsNullOrWhiteSpace(Model.MainImage)) { <figure class="article-image shell"><img src="@Model.MainImage" alt="@Model.Title" width="1200" height="720" /></figure> }
<div class="article-body shell">@Html.Raw(Model.Content) @if (!string.IsNullOrWhiteSpace(Model.AudioPath)) { <div class="audio-block"><strong>استمع بصوت الشاعرة</strong><audio controls preload="metadata" src="@Model.AudioPath">متصفحك لا يدعم تشغيل الصوت.</audio></div> } @if (!string.IsNullOrWhiteSpace(Model.DocumentPath)) { <a class="download-link" href="@Model.DocumentPath" download>تنزيل الكتاب أو الوثيقة</a> }</div></article>
