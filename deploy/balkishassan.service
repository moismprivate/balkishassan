[Unit]
Description=Balkis Hassan Arabische auteurswebsite
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=balkishassan
Group=balkishassan
WorkingDirectory=/opt/balkishassan/current
ExecStart=/usr/bin/dotnet /opt/balkishassan/current/BalkisHassan.Web.dll
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
SyslogIdentifier=balkishassan
EnvironmentFile=/etc/balkishassan/balkishassan.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/balkishassan/uploads

[Install]
WantedBy=multi-user.target
